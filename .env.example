
# ============================================
# GOOGLE GEMINI AI (Report Generation)
# ============================================
# Get your API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ============================================
# SUPABASE (Database + Auth)
# ============================================
# Get from: https://supabase.com → Your Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIs...

# ============================================
# RAZORPAY (Payment Gateway)
# ============================================
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# ============================================
# RESEND (Email Delivery - Primary)
# ============================================
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=onboarding@resend.dev

# ============================================
# GMAIL SMTP (Email Delivery - Fallback)
# ============================================
# Used automatically when Resend fails
# Setup: https://myaccount.google.com/apppasswords
GMAIL_USER=your.email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ============================================
# META PIXEL (Facebook/Instagram Ad Tracking)
# ============================================
NEXT_PUBLIC_META_PIXEL_ID=your_meta_pixel_id_here

# ============================================
# APP CONFIG
# ============================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=BhavishAI
NEXT_PUBLIC_REPORT_PRICE=299

# Upsell pricing (server-controlled)
NEXT_PUBLIC_PRICE_BASE=299
NEXT_PUBLIC_PRICE_BUMP=149
NEXT_PUBLIC_PRICE_UPGRADE=999

# ============================================
# SECURITY & AUTH
# ============================================
# Protects cron endpoints (required — used by Vercel Cron)
CRON_SECRET=your_cron_secret_here

# Separate admin password (optional — falls back to CRON_SECRET)
ADMIN_SECRET=your_admin_secret_here

# Internal API secret for server-to-server calls (optional — falls back to CRON_SECRET)
# Used by save-report to trigger email sequence generation, etc.
INTERNAL_API_SECRET=your_internal_secret_here
