# ============================================
# BhavishAI - Environment Variables
# ============================================
# Copy this file to .env.local and fill in your values
# Run: cp .env.example .env.local

# ============================================
# GOOGLE GEMINI AI (Report Generation)
# ============================================
# Get your API key from: https://aistudio.google.com/apikey
# Free tier: 15 requests/minute
GEMINI_API_KEY=your_gemini_api_key_here

# ============================================
# RAZORPAY (Payment Gateway)
# ============================================
# Sign up at: https://dashboard.razorpay.com/signup
# Get keys from: Dashboard > Settings > API Keys
# Use TEST keys for development, LIVE keys for production
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# ============================================
# RESEND (Email Delivery)
# ============================================
# Sign up at: https://resend.com/signup
# Get API key from: https://resend.com/api-keys
# Free tier: 3,000 emails/month
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=reports@bhavishai.in

# ============================================
# META PIXEL (Facebook/Instagram Ad Tracking)
# ============================================
# Get from: https://business.facebook.com/events_manager
# Create a pixel > Get Pixel ID
NEXT_PUBLIC_META_PIXEL_ID=your_meta_pixel_id_here

# ============================================
# APP CONFIGURATION
# ============================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=BhavishAI
NEXT_PUBLIC_REPORT_PRICE=199

# ============================================
# PRODUCTION NOTES:
# ============================================
# 1. Replace RAZORPAY test keys with live keys
# 2. Set NEXT_PUBLIC_APP_URL to your domain (https://bhavishai.in)
# 3. Set RESEND_FROM_EMAIL to your verified domain email
# 4. Add your real Meta Pixel ID
