
GEMINI_API_KEY=your_gemini_api_key_here
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=reports@bhavishai.in

# ============================================
# META PIXEL (Facebook/Instagram Ad Tracking)
# ============================================
# Get from: https://business.facebook.com/events_manager
# Create a pixel > Get Pixel ID
NEXT_PUBLIC_META_PIXEL_ID=your_meta_pixel_id_here

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=BhavishAI
NEXT_PUBLIC_REPORT_PRICE=199

# ============================================
# PRODUCTION NOTES:
# ============================================
# 1. Replace RAZORPAY test keys with live keys
# 2. Set NEXT_PUBLIC_APP_URL to your domain (https://bhavishai.in)
# 3. Set RESEND_FROM_EMAIL to your verified domain email
# 4. Add your real Meta Pixel ID

# ============================================
# GMAIL SMTP (Email Delivery - Fallback)
# ============================================
# Used automatically when Resend fails (e.g., unverified domain)
#
# HOW TO SET UP:
# 1. Enable 2-Factor Authentication on your Google account
# 2. Go to https://myaccount.google.com/apppasswords
# 3. Create an App Password for "Mail"
# 4. Copy the 16-character password (looks like: xxxx xxxx xxxx xxxx)
#
# NOTE: This is NOT your regular Gmail password!
GMAIL_USER=your.email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
